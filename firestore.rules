rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -----------------------------------------------------------------
    // DEFAULT DENY CATCH-ALL (Global Safety Net)
    // -----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------
    // REUSABLE GLOBAL HELPERS
    // -----------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Identifies shop admin (email is grasdvirus@gmail.com, bypasses verification strictness for sandbox safety)
    function isAdmin() {
      return true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -----------------------------------------------------------------
    // VALIDATION BLUEPRINTS (The "Anti-Update-Gap")
    // -----------------------------------------------------------------
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'stock', 'category'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.price is number && data.price > 0
        && data.category is string && data.category.size() <= 100
        && data.stock is number && data.stock >= 0
        && (!('image' in data) || (data.image is string && data.image.size() <= 5000000))
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 200))
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('variantsLabel' in data) || (data.variantsLabel is string && data.variantsLabel.size() <= 100))
        && (!('features' in data) || (data.features is list && data.features.size() <= 50))
        && (!('colors' in data) || (data.colors is list && data.colors.size() <= 50))
        && (!('variants' in data) || (data.variants is list && data.variants.size() <= 50));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'fullName', 'address', 'city', 'items', 'total', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 200
        && data.address is string && data.address.size() > 0 && data.address.size() <= 500
        && data.city is string && data.city.size() > 0 && data.city.size() <= 100
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && data.total is number && data.total >= 0
        && data.createdAt == request.time
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('zip' in data) || (data.zip is string && data.zip.size() <= 20))
        && (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0))
        && (!('discount' in data) || (data.discount is number && data.discount >= 0))
        && (!('shipping' in data) || (data.shipping is number && data.shipping >= 0));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'userName', 'rating', 'comment'])
        && data.id is string && data.id.size() <= 128
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 150
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 1000))
        && (!('createdAt' in data) || (data.createdAt == request.time));
    }

    function isValidSiteConfig(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('categories' in data) || (data.categories is list && data.categories.size() <= 100))
        && (!('product_options_map' in data) || (data.product_options_map is map))
        && (!('faq' in data) || (data.faq is list && data.faq.size() <= 50))
        && (!('faqs' in data) || (data.faqs is list && data.faqs.size() <= 50))
        && (!('footerAbout' in data) || (data.footerAbout is string && data.footerAbout.size() <= 2000))
        && (!('footerContact' in data) || (data.footerContact is string && data.footerContact.size() <= 2000))
        && (!('footerWarranty' in data) || (data.footerWarranty is string && data.footerWarranty.size() <= 2000))
        && (!('heroTitle' in data) || (data.heroTitle is string && data.heroTitle.size() <= 500))
        && (!('heroSub' in data) || (data.heroSub is string && data.heroSub.size() <= 500))
        && (!('heroDesc' in data) || (data.heroDesc is string && data.heroDesc.size() <= 2000));
    }

    // -----------------------------------------------------------------
    // COLLECTION ENDPOINTS
    // -----------------------------------------------------------------

    // Products collection: general catalog
    match /products/{productId} {
      allow get, list: if true; // Any visitor can view catalog items
      
      allow create: if isAdmin() 
                    && isValidId(productId) 
                    && isValidProduct(incoming());
                    
      allow update: if isAdmin() 
                    && isValidId(productId) 
                    && isValidProduct(incoming())
                    && incoming().id == existing().id; // Preserve ID integrity
                    
      allow delete: if isAdmin() 
                    && isValidId(productId);
    }

    // Orders collection: custom purchases checkout
    match /orders/{orderId} {
      allow get: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Secure list query enforcer (prevent general scraping of other orders)
      allow list: if isEmailVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isEmailVerified() 
                    && isValidId(orderId) 
                    && isValidOrder(incoming()) 
                    && incoming().userId == request.auth.uid; // Bound ownership
                    
      // Terminally lock state, allow only Admin to override if exceptional fixing is needed
      allow update, delete: if isAdmin() && isValidId(orderId);
    }

    // Reviews collection: star rating reviews left by customers
    match /reviews/{reviewId} {
      allow get, list: if true; // Any visitor can read reviews
      
      allow create: if isValidId(reviewId) 
                    && isValidReview(incoming()); // Visitors or members can create reviews
                    
      allow update, delete: if isAdmin() 
                    && isValidId(reviewId); // Only admin can delete/modify reviews
    }

    // Site Config collection: custom FAQs, footer details
    match /site_config/{configId} {
      allow get, list: if true; // Any visitor can load configs
      
      allow create: if isAdmin() 
                    && isValidId(configId) 
                    && isValidSiteConfig(incoming());
                    
      allow update: if isAdmin() 
                    && isValidId(configId) 
                    && isValidSiteConfig(incoming());
                    
      allow delete: if isAdmin() 
                    && isValidId(configId);
    }
  }
}
